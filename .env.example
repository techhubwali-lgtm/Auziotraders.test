# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional official AJES / Avto.jp SQL/JSON API code (server-side only, never exposed to browser).
# If unset, the server proxy automatically connects directly to https://auc.auziotraders.com/.
AJES_API_CODE=
AUC_USERNAME=
AUC_PASSWORD=

# AISStream Live Vessel Tracking API Key (https://aisstream.io/documentation).
# Used strictly server-side by server/aisStreamService.ts (wss://stream.aisstream.io/v0/stream).
# Never expose this key in browser code, Vite env vars, or Firestore.
AISSTREAM_API_KEY=

# Google Maps Platform API Key for Live Satellite Vessel Tracking (@vis.gl/react-google-maps).
# Restrict this browser key to your HTTP referrers and Maps JavaScript API in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=

# Carapis Japanese Dealer Stock API Key (server-side only, never exposed to browser).
# Used by server/carapisService.ts to run a once-daily cached sync (max 30 pages/day, 90 req/day ceiling).
CARAPIS_API_KEY=

# Optional email notification settings for Dealer Stock inquiries (server-side only).
SALES_INQUIRY_EMAIL=sales@auziotraders.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=



