    "ExportDocument": {
      "title": "ExportDocument",
      "description": "Export documentation record with server-enforced customer visibility isolation.",
      "type": "object",
      "properties": {
        "orderId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "orderNumber": { "type": "string", "minLength": 3, "maxLength": 32 },
