        },
        "fileName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "fileUrl": { "type": "string", "maxLength": 200000 },
        "isCustomerVisible": { "type": "boolean" },
        "uploadedByName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "notes": { "type": "string", "maxLength": 400 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "orderId", "orderNumber", "customerId", "title", "docType", "fileName",
        "fileUrl", "isCustomerVisible", "uploadedByName", "notes", "createdAt", "updatedAt"
      ]
    },
    "AuditLog": {
      "title": "AuditLog",
