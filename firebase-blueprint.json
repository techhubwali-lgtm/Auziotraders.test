  "firestore": {
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Customer/dealer and staff/admin user profiles enforcing RBAC and verification."
    },
    "/vehicles/{vehicleId}": {
      "schema": { "$ref": "#/entities/Vehicle" },
      "description": "Publicly browsable physical stock, auction listings, and partner stock."
    },
    "/sourcingRequests/{requestId}": {
      "schema": { "$ref": "#/entities/SourcingRequest" },
      "description": "Guided buyer sourcing requests isolated to owning customer and staff."
    },
    "/quotations/{quotationId}": {
      "schema": { "$ref": "#/entities/Quotation" },
      "description": "Itemized export quotations and customer maximum bid authorizations."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/ExportOrder" },
      "description": "14-stage export orders with vessel logistics and bid ceiling guard."
    },
    "/orderMessages/{messageId}": {
      "schema": { "$ref": "#/entities/OrderMessage" },
      "description": "Order correspondence enforcing strict separation of internal staff notes."
    },
    "/documents/{docId}": {
      "schema": { "$ref": "#/entities/ExportDocument" },
      "description": "Export document vault enforcing isCustomerVisible isolation."
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable chronological audit trail readable only by administrators."
    },
    "/inquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/Inquiry" },
      "description": "Public visitor inquiries with PII isolated to staff/admins."
    },
    "/orderStatus/{trackingCode}": {
      "schema": { "$ref": "#/entities/OrderStatus" },
      "description": "Public non-PII tracking lookup keyed by reference code."
    },
    "/companySettings/{settingId}": {
      "schema": { "$ref": "#/entities/CompanySettings" },
      "description": "Official SMBC Tokyo wire details and multi-currency exchange rates."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Administrator registry."
    }
  }
}
