        "includeInsurance": { "type": "boolean" },
        "fobPriceUsd": { "type": "number" },
        "freightUsd": { "type": "number" },
        "inspectionUsd": { "type": "number" },
        "insuranceUsd": { "type": "number" },
        "quotedCifUsd": { "type": "number" },
        "currency": { "type": "string", "enum": ["USD", "JPY", "EUR", "AUD", "GBP", "KES", "ZAR", "NZD", "CAD"] },
        "message": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string" },
        "vesselName": { "type": "string", "maxLength": 100 },
        "etaDate": { "type": "string", "maxLength": 40 },
        "adminNotes": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
