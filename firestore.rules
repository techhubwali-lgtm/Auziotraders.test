rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Helper Functions — AUZIO TRADERS Granular Backend RBAC & Validation
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedAuth() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function userDocExists() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userRole() {
      return userDocExists() ? userData().role : 'visitor';
    }

    function isActiveAccount() {
      return !userDocExists() ||
        !('accountStatus' in userData()) ||
        userData().accountStatus != 'suspended';
    }

    function isAdmin() {
      return (isVerifiedAuth() && request.auth.token.email == 'techhub.wali@gmail.com') ||
        (
          isSignedIn() &&
          isActiveAccount() && (
            exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
            userRole() == 'admin'
          )
        );
    }

    function hasExplicitPerm(moduleKey, action) {
      return isSignedIn() &&
        isActiveAccount() &&
        userDocExists() &&
        ('permissions' in userData()) &&
        userData().permissions is map &&
        (moduleKey in userData().permissions) &&
        userData().permissions[moduleKey] is list &&
        userData().permissions[moduleKey].hasAny([action]);
    }

    function isManagement() {
      return isAdmin() || (isSignedIn() && isActiveAccount() && userRole() == 'management');
    }

    function isSalesManager() {
      return isManagement() || (isSignedIn() && isActiveAccount() && userRole() == 'sales_manager');
    }

    function isSales() {
      return isSalesManager() || (isSignedIn() && isActiveAccount() && userRole() == 'sales');
    }

    function isAccounts() {
      return isManagement() || (isSignedIn() && isActiveAccount() && userRole() == 'accounts');
    }

    function isOperations() {
      return isManagement() || (isSignedIn() && isActiveAccount() && userRole() == 'operations');
    }

    function isHr() {
      return isManagement() || (isSignedIn() && isActiveAccount() && userRole() == 'hr');
    }

    function isIt() {
      return isAdmin() || (isSignedIn() && isActiveAccount() && userRole() == 'it');
    }

    function isStaff() {
      return isAdmin() || (
        isSignedIn() &&
        isActiveAccount() &&
        userRole() in ['sales', 'sales_manager', 'accounts', 'operations', 'hr', 'it', 'management', 'admin']
      );
    }

    function canAccessModule(moduleKey, action, defaultAllowed) {
      return isAdmin() || (isActiveAccount() && (defaultAllowed || hasExplicitPerm(moduleKey, action)));
    }

    function isNonEmptyString(val, maxLen) {
      return val is string && val.size() > 0 && val.size() <= maxLen;
    }

    function isOptionalString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    function isNonNegativeNumber(val) {
      return val is number && val >= 0;
    }

    function isValidCurrency(curr) {
      return curr is string && curr.matches('^[A-Z]{3}$');
    }

    function isValidShippingMethod(method) {
      return method in ['roro', 'container_20ft', 'container_40ft'];
    }

    function isValidPersistedRole(role) {
      return role in [
        'customer',
        'dealer',
        'sales',
        'sales_manager',
        'accounts',
        'operations',
        'hr',
        'it',
        'management',
        'admin'
      ];
    }

    function isValidPublicRegistrationRole(role) {
      return role in ['customer', 'dealer'];
    }

    function isValidVehicle(data) {
      return isNonEmptyString(data.stockCode, 40) &&
        isNonEmptyString(data.make, 50) &&
        isNonEmptyString(data.model, 80) &&
        data.year is int && data.year >= 1980 && data.year <= 2030 &&
        data.mileageKm is number && data.mileageKm >= 0 && data.mileageKm <= 2000000 &&
        data.engineCc is number && data.engineCc >= 0 && data.engineCc <= 15000 &&
        data.volumeM3 is number && data.volumeM3 > 0 && data.volumeM3 <= 120 &&
        data.fobPriceUsd is number && data.fobPriceUsd > 0 && data.fobPriceUsd <= 5000000 &&
        data.status in ['available', 'reserved', 'sold', 'archived'] &&
        data.images is list && data.images.size() >= 1 && data.images.size() <= 30;
    }

    function isValidPublicInquiry(data) {
      return isNonEmptyString(data.trackingCode, 30) &&
        data.type in ['inquiry', 'reservation'] &&
        isNonEmptyString(data.vehicleId, 80) &&
        isNonEmptyString(data.vehicleStockCode, 40) &&
        isNonEmptyString(data.vehicleTitle, 140) &&
        isNonEmptyString(data.buyerName, 100) &&
        isNonEmptyString(data.buyerEmail, 120) &&
        isOptionalString(data.buyerPhone, 40) &&
        isNonEmptyString(data.buyerCountry, 80) &&
        isNonEmptyString(data.destinationPortId, 60) &&
        isNonEmptyString(data.destinationPortName, 100) &&
        isValidShippingMethod(data.shippingMethod) &&
        data.includeInsurance is bool &&
        isNonNegativeNumber(data.fobPriceUsd) &&
        isNonNegativeNumber(data.freightUsd) &&
        isNonNegativeNumber(data.inspectionUsd) &&
        isNonNegativeNumber(data.insuranceUsd) &&
        isNonNegativeNumber(data.quotedCifUsd) &&
        isValidCurrency(data.currency) &&
        isOptionalString(data.message, 1500) &&
        data.status == 'received';
    }

    function isValidOrderStatusCreate(data, trackingCode) {
      return data.trackingCode == trackingCode &&
        isNonEmptyString(data.inquiryId, 80) &&
        isNonEmptyString(data.vehicleStockCode, 40) &&
        isNonEmptyString(data.vehicleTitle, 140) &&
        isNonEmptyString(data.destinationPortName, 100) &&
        isValidShippingMethod(data.shippingMethod) &&
        isNonNegativeNumber(data.quotedCifUsd) &&
        isValidCurrency(data.currency) &&
        data.milestone == 'received';
    }

    function isValidFinanceRecord(data) {
      return data.type in ['invoice', 'payment', 'expense'] &&
        isNonEmptyString(data.referenceCode, 40) &&
        isNonEmptyString(data.counterpartyName, 120) &&
        isNonEmptyString(data.category, 80) &&
        isNonNegativeNumber(data.amountUsd) &&
        data.amountUsd <= 50000000 &&
        isValidCurrency(data.currency) &&
        data.status in ['paid', 'pending', 'overdue', 'reconciled'] &&
        data.reconciled is bool &&
        isNonEmptyString(data.transactionDate, 32) &&
        isOptionalString(data.notes, 800);
    }

    function isValidHrEmployee(data) {
      return isNonEmptyString(data.employeeCode, 32) &&
        isNonEmptyString(data.fullName, 100) &&
        isOptionalString(data.email, 120) &&
        isNonEmptyString(data.department, 60) &&
        isNonEmptyString(data.jobTitle, 80) &&
        data.status in ['active', 'on_leave', 'inactive'] &&
        isNonNegativeNumber(data.baseSalaryUsd) &&
        data.baseSalaryUsd <= 1000000 &&
        data.performanceRating is number && data.performanceRating >= 1 && data.performanceRating <= 5;
    }

    function isValidHrLeaveRequest(data) {
      return isNonEmptyString(data.employeeName, 100) &&
        data.leaveType in ['annual', 'sick', 'personal', 'unpaid'] &&
        isNonEmptyString(data.startDate, 32) &&
        isNonEmptyString(data.endDate, 32) &&
        data.days is number && data.days >= 1 && data.days <= 90 &&
        data.status in ['pending', 'approved', 'rejected'] &&
        isOptionalString(data.reason, 500);
    }

    function isValidTeamTask(data) {
      return isNonEmptyString(data.title, 140) &&
        isOptionalString(data.description, 800) &&
        isNonEmptyString(data.department, 60) &&
        data.priority in ['low', 'medium', 'high', 'urgent'] &&
        data.status in ['todo', 'in_progress', 'review', 'done'];
    }

    function isValidSalesTarget(data) {
      return isNonEmptyString(data.staffName, 100) &&
        isNonEmptyString(data.period, 40) &&
        isNonNegativeNumber(data.targetRevenueUsd) &&
        isNonNegativeNumber(data.achievedRevenueUsd) &&
        isNonNegativeNumber(data.targetUnits) &&
        isNonNegativeNumber(data.soldUnits) &&
        data.commissionRatePct is number && data.commissionRatePct >= 0 && data.commissionRatePct <= 35;
    }

    function bankingFieldsUnchanged() {
      return request.resource.data.bankName == resource.data.bankName &&
        request.resource.data.bankBranch == resource.data.bankBranch &&
        request.resource.data.accountName == resource.data.accountName &&
        request.resource.data.accountNumber == resource.data.accountNumber &&
        request.resource.data.swiftCode == resource.data.swiftCode &&
        request.resource.data.bankAddress == resource.data.bankAddress;
    }

    function isValidStaffInvitation(data) {
      return isNonEmptyString(data.employeeName, 100) &&
        isNonEmptyString(data.employeeCode, 32) &&
        isNonEmptyString(data.officialEmail, 120) &&
        isNonEmptyString(data.department, 60) &&
        data.designationLevel in ['director', 'manager', 'executive', 'assistant'] &&
        isOptionalString(data.reportingManagerName, 100) &&
        data.role in ['sales', 'sales_manager', 'accounts', 'operations', 'hr', 'it', 'management', 'admin'] &&
        data.twoFactorRequired is bool &&
        data.status in ['pending', 'accepted', 'revoked'];
    }

    function isValidStaffInvitationClaim(uid) {
      return isVerifiedAuth() &&
        isOwner(uid) &&
        ('invitationId' in request.resource.data) &&
        isValidId(request.resource.data.invitationId) &&
        exists(/databases/$(database)/documents/staffInvitations/$(request.resource.data.invitationId)) &&
        get(/databases/$(database)/documents/staffInvitations/$(request.resource.data.invitationId)).data.status == 'pending' &&
        get(/databases/$(database)/documents/staffInvitations/$(request.resource.data.invitationId)).data.officialEmail == request.auth.token.email.lower() &&
        request.resource.data.uid == uid &&
        request.resource.data.role == get(/databases/$(database)/documents/staffInvitations/$(request.resource.data.invitationId)).data.role &&
        request.resource.data.accountStatus == 'active' &&
        getAfter(/databases/$(database)/documents/staffInvitations/$(request.resource.data.invitationId)).data.status == 'accepted';
    }

    // =========================================================================
    // 1. User Profiles & Granular Role/Permission Registry
    // =========================================================================

    match /users/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || isStaff());
      allow list: if isStaff();

      // Self-registration strictly restricted to customer or dealer role.
      // Staff accounts can ONLY be created by Admins OR by claiming an Admin-issued invitation matching verified email.
      allow create: if isValidId(uid) && (
        (
          isOwner(uid) &&
          isValidPublicRegistrationRole(request.resource.data.role) &&
          request.resource.data.uid == uid &&
          !('permissions' in request.resource.data) &&
          (!('accountStatus' in request.resource.data) || request.resource.data.accountStatus == 'active') &&
          isNonEmptyString(request.resource.data.email, 160) &&
          isNonEmptyString(request.resource.data.displayName, 120)
        ) || isValidStaffInvitationClaim(uid) || (
          canAccessModule('users', 'create', isAdmin()) &&
          isValidPersistedRole(request.resource.data.role)
        )
      );

      // Users can update basic profile details, but CANNOT self-escalate role, verified flag, accountStatus, or permissions
      allow update: if isValidId(uid) && (
        (
          isOwner(uid) &&
          isActiveAccount() &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.verified == resource.data.verified &&
          (!('accountStatus' in request.resource.data) || request.resource.data.accountStatus == resource.data.accountStatus) &&
          (!('permissions' in request.resource.data) || request.resource.data.permissions == resource.data.permissions)
        ) || (
          canAccessModule('users', 'edit', isManagement()) &&
          isValidPersistedRole(request.resource.data.role) &&
          (
            isAdmin() || (
              request.resource.data.role != 'admin' &&
              (!('permissions' in request.resource.data) || request.resource.data.permissions == resource.data.permissions)
            )
          )
        )
      );

      allow delete: if isValidId(uid) && isAdmin();
    }

    match /admins/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || isAdmin());
      allow list, create, update, delete: if isAdmin();
    }

    // =========================================================================
    // 2. Public & Internal Vehicle Inventory
    // =========================================================================

    match /vehicles/{vehicleId} {
      allow read: if true;
      allow create: if isValidId(vehicleId) &&
        canAccessModule('inventory', 'create', isOperations()) &&
        isValidVehicle(request.resource.data);
      allow update: if isValidId(vehicleId) &&
        canAccessModule('inventory', 'edit', isOperations()) &&
        isValidVehicle(request.resource.data);
      allow delete: if isValidId(vehicleId) &&
        canAccessModule('inventory', 'delete', isAdmin());
    }

    // =========================================================================
    // 3. Sourcing Requests
    // =========================================================================

    match /sourcingRequests/{reqId} {
      allow get, list: if isStaff() ||
        (isSignedIn() && resource.data.customerId == request.auth.uid);

      allow create: if isValidId(reqId) && isSignedIn() && (
        canAccessModule('auctions', 'create', isSales() || isOperations()) ||
        (
          request.resource.data.customerId == request.auth.uid &&
          request.resource.data.status == 'new' &&
          request.resource.data.maxBidAcknowledged == true &&
          isNonEmptyString(request.resource.data.make, 60) &&
          isNonEmptyString(request.resource.data.model, 80) &&
          request.resource.data.maxBudgetUsd is number &&
          request.resource.data.maxBudgetUsd > 0 &&
          isValidCurrency(request.resource.data.budgetCurrency)
        )
      );

      allow update: if isValidId(reqId) && (
        canAccessModule('auctions', 'edit', isSales() || isOperations()) ||
        (
          isSignedIn() &&
          resource.data.customerId == request.auth.uid &&
          request.resource.data.customerId == resource.data.customerId &&
          resource.data.status == 'new' &&
          request.resource.data.status == 'new'
        )
      );

      allow delete: if isValidId(reqId) && isAdmin();
    }

    // =========================================================================
    // 4. Quotations & Customer Approval
    // =========================================================================

    match /quotations/{quoteId} {
      allow get, list: if isStaff() ||
        (isSignedIn() && resource.data.customerId == request.auth.uid);

      allow create: if isValidId(quoteId) &&
        canAccessModule('sales', 'create', isSales()) &&
        isNonEmptyString(request.resource.data.quoteNumber, 40) &&
        isNonEmptyString(request.resource.data.customerId, 128) &&
        isNonNegativeNumber(request.resource.data.totalCifUsd) &&
        isNonNegativeNumber(request.resource.data.authorizedMaxBidUsd) &&
        isValidCurrency(request.resource.data.currency);

      allow update: if isValidId(quoteId) && (
        canAccessModule('sales', 'edit', isSales() || isAccounts()) ||
        (
          isSignedIn() &&
          resource.data.customerId == request.auth.uid &&
          resource.data.status == 'sent' &&
          request.resource.data.status in ['approved', 'declined'] &&
          request.resource.data.totalCifUsd == resource.data.totalCifUsd &&
          request.resource.data.authorizedMaxBidUsd == resource.data.authorizedMaxBidUsd &&
          request.resource.data.customerId == resource.data.customerId &&
          request.resource.data.quoteNumber == resource.data.quoteNumber
        )
      );

      allow delete: if isValidId(quoteId) && isAdmin();
    }

    // =========================================================================
    // 5. Export Orders & Bid Ceiling Guardrail
    // =========================================================================

    match /orders/{orderId} {
      allow get, list: if isStaff() ||
        (isSignedIn() && resource.data.customerId == request.auth.uid);

      allow create: if isValidId(orderId) &&
        canAccessModule('orders', 'create', isSales() || isOperations()) &&
        isNonEmptyString(request.resource.data.orderNumber, 40) &&
        isNonEmptyString(request.resource.data.customerId, 128) &&
        isNonNegativeNumber(request.resource.data.authorizedMaxBidUsd) &&
        isNonNegativeNumber(request.resource.data.placedBidUsd) &&
        (
          request.resource.data.authorizedMaxBidUsd == 0 ||
          request.resource.data.placedBidUsd <= request.resource.data.authorizedMaxBidUsd
        );

      allow update: if isValidId(orderId) &&
        canAccessModule('orders', 'edit', isOperations() || isSalesManager() || isAccounts()) &&
        isNonNegativeNumber(request.resource.data.placedBidUsd) &&
        (
          request.resource.data.authorizedMaxBidUsd == 0 ||
          request.resource.data.placedBidUsd <= request.resource.data.authorizedMaxBidUsd
        );

      allow delete: if isValidId(orderId) && isAdmin();
    }

    // =========================================================================
    // 6. Order Messages (Internal Staff Notes Hidden from Customers)
    // =========================================================================

    match /orderMessages/{msgId} {
      allow get, list: if isStaff() || (
        isSignedIn() &&
        resource.data.customerId == request.auth.uid &&
        resource.data.isInternalStaffOnly == false
      );

      allow create: if isValidId(msgId) && isSignedIn() &&
        isNonEmptyString(request.resource.data.orderId, 80) &&
        isNonEmptyString(request.resource.data.body, 2000) &&
        request.resource.data.senderUid == request.auth.uid &&
        (
          isStaff() ||
          (
            request.resource.data.customerId == request.auth.uid &&
            request.resource.data.isInternalStaffOnly == false
          )
        );

      allow update, delete: if isValidId(msgId) && isAdmin();
    }

    // =========================================================================
    // 7. Export Documents Vault (Internal Cost Sheets Hidden from Customers)
    // =========================================================================

    match /documents/{docId} {
      allow get, list: if isStaff() || (
        isSignedIn() &&
        resource.data.customerId == request.auth.uid &&
        resource.data.isCustomerVisible == true
      );

      allow create, update: if isValidId(docId) &&
        canAccessModule('documents', 'create', isOperations() || isSalesManager() || isAccounts()) &&
        isNonEmptyString(request.resource.data.orderId, 80) &&
        isNonEmptyString(request.resource.data.title, 140) &&
        isNonEmptyString(request.resource.data.fileName, 160);

      allow delete: if isValidId(docId) &&
        canAccessModule('documents', 'delete', isOperations());
    }

    // =========================================================================
    // 8. Immutable Audit Logs
    // =========================================================================

    match /auditLogs/{logId} {
      allow get, list: if canAccessModule('settings', 'view', isManagement() || isIt() || isAccounts());
      allow create: if isValidId(logId) && isSignedIn() &&
        isNonEmptyString(request.resource.data.action, 80) &&
        isNonEmptyString(request.resource.data.summary, 400);
      allow update, delete: if false;
    }

    // =========================================================================
    // 9. Public Inquiries, Tracking & Protected Company / Banking Settings
    // =========================================================================

    match /inquiries/{inquiryId} {
      allow create: if isValidId(inquiryId) && isValidPublicInquiry(request.resource.data);
      allow get, list: if isStaff();
      allow update: if isValidId(inquiryId) && canAccessModule('crm', 'edit', isSales() || isOperations());
      allow delete: if isValidId(inquiryId) && canAccessModule('crm', 'delete', isAdmin());
    }

    match /orderStatus/{trackingCode} {
      allow get: if true;
      allow list: if isStaff();
      allow create: if isValidOrderStatusCreate(request.resource.data, trackingCode) || isStaff();
      allow update, delete: if isStaff();
    }

    match /companySettings/{docId} {
      allow get: if docId in ['public', 'exportProfile'] || isStaff();
      allow list: if isStaff();
      // Creating or modifying banking fields is strictly restricted to Owner/Super Admin or explicit banking:edit
      allow create: if isAdmin() || hasExplicitPerm('banking', 'edit');
      allow update: if isAdmin() ||
        hasExplicitPerm('banking', 'edit') ||
        (
          canAccessModule('settings', 'edit', isManagement() || isIt()) &&
          bankingFieldsUnchanged()
        );
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 10. Landing Page CMS & Verified Customer Testimonials
    // =========================================================================

    match /landingContent/{docId} {
      allow get: if docId == 'public' || isStaff();
      allow list: if isStaff();
      allow create, update, delete: if canAccessModule('cms', 'edit', isManagement() || isIt());
    }

    match /testimonials/{testimonialId} {
      allow get, list: if resource.data.approved == true || isStaff();
      allow create, update: if isValidId(testimonialId) &&
        canAccessModule('cms', 'edit', isManagement()) &&
        isNonEmptyString(request.resource.data.customerName, 100) &&
        isNonEmptyString(request.resource.data.country, 80) &&
        isNonEmptyString(request.resource.data.vehiclePurchased, 120) &&
        isNonEmptyString(request.resource.data.reviewText, 1200) &&
        request.resource.data.rating is int &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        request.resource.data.approved is bool;
      allow delete: if isValidId(testimonialId) && canAccessModule('cms', 'delete', isManagement());
    }

    // =========================================================================
    // 11. Accounts & Finance Ledger (Backend Enforced)
    // =========================================================================

    match /financeRecords/{recordId} {
      // Strictly Owner, Management, Accounts, or explicitly authorized accounts:view (never Sales Executives or Customers)
      allow get, list: if canAccessModule('accounts', 'view', isAccounts());
      allow create: if isValidId(recordId) &&
        canAccessModule('accounts', 'create', isAccounts()) &&
        isValidFinanceRecord(request.resource.data);
      allow update: if isValidId(recordId) &&
        canAccessModule('accounts', 'edit', isAccounts()) &&
        isValidFinanceRecord(request.resource.data);
      allow delete: if isValidId(recordId) &&
        canAccessModule('accounts', 'delete', isAdmin());
    }

    // =========================================================================
    // 12. Human Resources — Employees & Leave Approvals (Backend Enforced)
    // =========================================================================

    match /hrEmployees/{empId} {
      allow get, list: if canAccessModule('hr', 'view', isHr() || isAccounts());
      allow create: if isValidId(empId) &&
        canAccessModule('hr', 'create', isHr()) &&
        isValidHrEmployee(request.resource.data);
      allow update: if isValidId(empId) &&
        canAccessModule('hr', 'edit', isHr()) &&
        isValidHrEmployee(request.resource.data);
      allow delete: if isValidId(empId) &&
        canAccessModule('hr', 'delete', isAdmin() || userRole() == 'hr');
    }

    match /hrLeaveRequests/{reqId} {
      allow get, list: if canAccessModule('hr', 'view', isHr());
      allow create: if isValidId(reqId) &&
        isStaff() &&
        request.resource.data.status == 'pending' &&
        isValidHrLeaveRequest(request.resource.data);
      allow update: if isValidId(reqId) &&
        canAccessModule('hr', 'approve', isHr()) &&
        isValidHrLeaveRequest(request.resource.data);
      allow delete: if isValidId(reqId) && isAdmin();
    }

    // =========================================================================
    // 13. Employee Task Management & Internal Team Messaging
    // =========================================================================

    match /teamTasks/{taskId} {
      allow get, list: if isStaff();
      allow create: if isValidId(taskId) && isStaff() && isValidTeamTask(request.resource.data);
      allow update: if isValidId(taskId) && isStaff() && isValidTeamTask(request.resource.data);
      allow delete: if isValidId(taskId) && (isManagement() || hasExplicitPerm('reports', 'delete'));
    }

    match /teamMessages/{msgId} {
      allow get, list: if isStaff();
      allow create: if isValidId(msgId) &&
        isStaff() &&
        request.resource.data.senderUid == request.auth.uid &&
        request.resource.data.channel in ['general', 'sales', 'operations', 'accounts', 'management'] &&
        isNonEmptyString(request.resource.data.body, 1500);
      allow update, delete: if isValidId(msgId) && isAdmin();
    }

    // =========================================================================
    // 14. Sales Targets & Commission Plans
    // =========================================================================

    match /salesTargets/{targetId} {
      allow get, list: if isStaff();
      allow create, update: if isValidId(targetId) &&
        canAccessModule('sales', 'approve', isSalesManager()) &&
        isValidSalesTarget(request.resource.data);
      allow delete: if isValidId(targetId) && canAccessModule('sales', 'delete', isManagement());
    }

    // =========================================================================
    // 15. Admin-Provisioned Staff Invitations (No Staff Self-Registration)
    // =========================================================================

    match /staffInvitations/{inviteId} {
      allow get, list: if canAccessModule('users', 'view', isManagement() || isHr()) ||
        (isVerifiedAuth() && resource.data.officialEmail == request.auth.token.email.lower());

      allow create: if isValidId(inviteId) &&
        canAccessModule('users', 'create', isManagement()) &&
        isValidStaffInvitation(request.resource.data) &&
        request.resource.data.status == 'pending' &&
        (isAdmin() || request.resource.data.role != 'admin');

      allow update: if isValidId(inviteId) && (
        (
          canAccessModule('users', 'edit', isManagement()) &&
          isValidStaffInvitation(request.resource.data) &&
          (isAdmin() || request.resource.data.role != 'admin')
        ) || (
          isVerifiedAuth() &&
          resource.data.status == 'pending' &&
          resource.data.officialEmail == request.auth.token.email.lower() &&
          request.resource.data.status == 'accepted' &&
          request.resource.data.acceptedByUid == request.auth.uid &&
          request.resource.data.officialEmail == resource.data.officialEmail &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.department == resource.data.department
        )
      );

      allow delete: if isValidId(inviteId) && canAccessModule('users', 'delete', isAdmin());
    }
  }
}
